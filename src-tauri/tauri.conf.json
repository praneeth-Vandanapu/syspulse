{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SysPulse",
  "version": "0.6.0",
  "identifier": "io.github.praneeth.syspulse",
  "build": {
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "SysPulse",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "Utility",
    "shortDescription": "System monitor and utility suite",
    "longDescription": "SysPulse by Praneeth: system and GPU monitor, hardware inventory, process manager and maintenance tools for Ubuntu.",
    "publisher": "Praneeth",
    "copyright": "Copyright (c) 2026 Praneeth",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "policykit-1",
          "pciutils",
          "usbutils",
          "apt",
          "x11-utils",
          "x11-xserver-utils",
          "pulseaudio-utils",
          "gstreamer1.0-x",
          "gstreamer1.0-pulseaudio",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-ugly",
          "gstreamer1.0-libav",
          "libpcap0.8"
        ],
        "files": {
          "/usr/share/polkit-1/actions/io.github.praneeth.syspulse.policy": "../packaging/linux/io.github.praneeth.syspulse.policy"
        }
      }
    }
  }
}
